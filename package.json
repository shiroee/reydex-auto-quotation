{
  "name": "reydex-auto-quotation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "create-user": "node --env-file=.env.local scripts/create-user.mjs",
    "grant-admin": "tsx --env-file=.env.local scripts/grant-admin.mts",
    "make-icons": "node scripts/make-icons.mjs",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file=.env.local scripts/db-migrate.mts",
    "db:seed": "tsx --env-file=.env.local scripts/db-seed.mts",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed-samples": "tsx --env-file=.env.local scripts/db-seed-samples.mts",
    "db:seed-brochure": "tsx --env-file=.env.local scripts/db-seed-brochure.mts",
    "db:seed-service-report": "tsx --env-file=.env.local scripts/db-seed-service-report.mts",
    "db:seed-pm-report": "tsx --env-file=.env.local scripts/db-seed-pm-report.mts",
    "extract-pdf-photos": "tsx scripts/extract-pdf-photos.mts"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.4.2-beta",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
